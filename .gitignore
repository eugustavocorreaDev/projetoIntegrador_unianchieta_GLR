# --- Segredos e configuração local ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Testes, lint e cobertura ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Modelos, caches e volumes locais (pesados, nunca versionar) ---
.cache/
models/
*.onnx
*.gguf
*.bin
*.safetensors
qdrant_storage/
.qdrant_local/
ollama_data/
volumes/

# --- Dados baixados de terceiros (regerados por scripts/download_fastapi_docs.py) ---
data/external/

# --- Logs de execução (copie trechos relevantes para evidencias/logs/) ---
logs/*
!logs/.gitkeep

# --- Resultados de avaliação: versionar só os que viram evidência ---
eval/results/*
!eval/results/.gitkeep

# --- Claude Code: o subagente (.claude/agents/) é versionado; configurações locais não ---
.claude/settings.local.json

# --- IDEs e sistema operacional ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
