# Copie para .env (cp .env.example .env) e ajuste se necessário.
# O projeto NÃO usa chaves de API pagas: tudo roda localmente com Ollama e Qdrant.
# Nunca coloque segredos ou dados pessoais neste arquivo de exemplo.

# --- Modos de execução ---
# Oficial (Docker e avaliação): LLM_MODE=ollama, EMBED_MODE=ollama, QDRANT_MODE=server.
# Caminho Windows sem Ollama (scripts/run_local.ps1 ajusta sozinho):
#   LLM_MODE=mock  -> respondedor extrativo (NÃO é um LLM; só para ver o fluxo e a UI)
#   EMBED_MODE=hash -> embeddings por hashing (sem semântica)
#   QDRANT_MODE=local -> Qdrant embutido em disco, na pasta QDRANT_PATH
LLM_MODE=ollama
EMBED_MODE=ollama
QDRANT_MODE=server
QDRANT_PATH=.qdrant_local

# --- Ollama (embeddings e geração) ---
# Valores para rodar FORA do Docker. O docker-compose.yml já aponta para os serviços internos
# (ollama, qdrant, api) e usa este arquivo só para os modelos e parâmetros.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Prefixos recomendados pelo nomic-embed-text; deixe vazio para outros modelos
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOCUMENT_PREFIX="search_document: "
EMBED_BATCH_SIZE=32
# Mesmo modelo nos dois caminhos. No Windows, o instalar.ps1 baixa este modelo, e o run_local.ps1
# usa este valor se estiver instalado; senão, o primeiro instalado entre llama3.2:3b e qwen2.5:3b.
LLM_MODEL=qwen2.5:3b
# Modelo de visão (opcional): lê o texto de prints enviados com a pergunta (~3,2 GB)
VISION_MODEL=qwen2.5vl:3b
# Caminho Docker: true faz o serviço ollama-pull baixar também o modelo de visão
PULL_VISION_MODEL=false
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=4096
LLM_MAX_TOKENS=512
LLM_SEED=42
REQUEST_TIMEOUT_S=180

# --- Qdrant (banco vetorial) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=techdocs

# --- Ingestão e chunking ---
DOCS_DIR=data/raw_docs
# fixed | recursive
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Recuperação ---
# vector | bm25 | hybrid | hybrid_rerank. Padrão hybrid: o reranker piorou o Recall@5 na
# medição de 14/11 (ADR 002 em docs/arquitetura.md); hybrid_rerank fica para comparação.
RETRIEVAL_MODE=hybrid
TOP_K=5
CANDIDATES_K=20
RRF_K=60
RERANKER_MODEL=ms-marco-MultiBERT-L-12
RERANKER_CACHE_DIR=.cache/flashrank
# Similaridade de cosseno mínima do melhor trecho para chamar o LLM (0 desativa).
# Calibre com o best_threshold do eval/run_eval.py (conjunto de desenvolvimento).
MIN_VECTOR_SCORE=0.0

# --- Verificação das respostas (camada anti-alucinação) ---
# Fração mínima das afirmações com citação [n]
MIN_CITATION_COVERAGE=0.5
# Fração mínima dos termos de cada afirmação que precisam estar no trecho citado
MIN_SUPPORT_RATIO=0.3

# --- API ---
# POST /ingest recria as coleções; use false em qualquer ambiente compartilhado
ENABLE_INGEST_ENDPOINT=true

# --- Logs ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Interface ---
API_URL=http://localhost:8000
OLLAMA_PORT=11434
